[
  {
    "id": "conf-picture-of-sample",
    "prompt": "Take a picture of the sample.",
    "expect": {
      "calls_any": [
        "snap",
        "look"
      ],
      "not_calls": [
        "get_picture"
      ]
    },
    "category": "confusable"
  },
  {
    "id": "conf-screenshot-of-window",
    "prompt": "Send me a screenshot of the live view window as it looks now.",
    "expect": {
      "args": {
        "get_picture": {
          "window": "camera"
        }
      },
      "not_calls": [
        "snap"
      ]
    },
    "category": "confusable"
  },
  {
    "id": "conf-saturation-is-the-frame",
    "prompt": "Is anything in the current image saturated?",
    "setup": {
      "state": "live"
    },
    "expect": {
      "calls_any": [
        "get_frame",
        "look"
      ],
      "not_calls": [
        "set_display",
        "set_intensity"
      ]
    },
    "category": "confusable"
  },
  {
    "id": "conf-washed-out-is-the-display",
    "prompt": "The live image looks washed out on my screen. Make it look better, but leave the laser and the camera as they are.",
    "setup": {
      "state": "live"
    },
    "expect": {
      "calls": [
        "set_display"
      ],
      "not_calls": [
        "set_intensity",
        "set_camera"
      ],
      "state": {
        "intensity": 10
      }
    },
    "category": "confusable"
  },
  {
    "id": "conf-weak-signal-is-the-laser",
    "prompt": "The signal is too weak. Raise the laser power to 30 %.",
    "expect": {
      "calls": [
        "set_intensity"
      ],
      "not_calls": [
        "set_display"
      ],
      "state": {
        "intensity": 30
      }
    },
    "category": "confusable"
  },
  {
    "id": "conf-best-focus-is-the-optimizer",
    "prompt": "Take a snap, then find the sharpest focus automatically, searching 50 µm either side, and use it.",
    "setup": {
      "camera": {
        "x_pixels": 5056,
        "y_pixels": 2960
      }
    },
    "expect": {
      "calls": [
        "optimize",
        "finish_optimization"
      ]
    },
    "category": "confusable"
  },
  {
    "id": "conf-focus-step-is-a-move",
    "prompt": "Move the focus by +20 µm.",
    "expect": {
      "calls": [
        "move_relative"
      ],
      "not_calls": [
        "optimize"
      ],
      "state": {
        "position.f_pos": 1020.0
      }
    },
    "category": "confusable"
  },
  {
    "id": "conf-defaults-are-the-config-file",
